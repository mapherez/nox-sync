{
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitAny": true,
    "rootDir": "src",
    "noUnusedLocals": true,
    "outDir": "dist",
    "strict": true,
    "target": "ES2022",
    "types": []
  },
  "include": ["src/**/*.ts"]
}
